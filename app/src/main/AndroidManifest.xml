            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <!-- Значок приложения: включён ровно один алиас, остальные выключает AppIcon.apply() (настройки → иконка).
             Стандартный: посёлок на зелёном фоне. -->

